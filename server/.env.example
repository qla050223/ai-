# ===== 服务端口 =====
PORT=3000

# ===== MySQL 连接配置（按本机实际填写）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 在这里填入你的 MySQL root 密码（MySQL80 安装时设置的密码）
DB_PASSWORD=
DB_NAME=ai_interview
DB_CONNECTION_LIMIT=10

# ===== JWT 密钥（生产环境请改成随机长字符串）=====
JWT_SECRET=ai_interview_dev_secret_change_me
JWT_EXPIRES_IN=7d
