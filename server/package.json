{
  "name": "ai-interview-server",
  "version": "1.0.0",
  "description": "AI 智能面试平台后端（Express + MySQL）",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test src/modules/**/*.test.js",
    "test:auth": "node --test src/modules/auth/auth.test.js",
    "test:position": "node --test src/modules/position/position.test.js",
    "test:interview": "node --test src/modules/interview/interview.test.js",
    "test:resume": "node --test src/modules/resume/resume.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "mysql2": "^3.11.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
